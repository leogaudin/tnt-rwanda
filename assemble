#!/usr/bin/env bash
# Builds the Android app for one country.
#
#   ./assemble <release|debug> <country> [--aab] [--open]
#
# The country is a folder of app/countries/ (e.g. malawi, rwanda). In a
# standalone export the country argument is optional (app/countries/default.json).
# Output: dist/mobile/<country>-<version>-<mode>.(apk|aab)
set -euo pipefail

ROOT="$(cd "$(dirname "$0")" && pwd)"
COUNTRIES="$ROOT/app/countries"

available() {
	for d in "$COUNTRIES"/*/; do
		name="$(basename "$d")"
		[ -f "$d/config.json" ] && echo "  $name"
	done
}

usage() {
	cat >&2 <<USAGE
Usage: ./assemble <release|debug> <country> [--aab] [--open]

Available countries:
$(available)
USAGE
	exit 1
}

MODE=""
COUNTRY=""
AAB=0
OPEN=0
for arg in "$@"; do
	case "$arg" in
		--aab) AAB=1 ;;
		--open) OPEN=1 ;;
		-h|--help) usage ;;
		--*) echo "Unknown option: $arg" >&2; usage ;;
		*)
			if [ -z "$MODE" ]; then MODE="$arg"
			elif [ -z "$COUNTRY" ]; then COUNTRY="$arg"
			else echo "Too many arguments" >&2; usage; fi
			;;
	esac
done

case "$MODE" in
	release|debug) ;;
	ios) echo "iOS builds are not supported." >&2; exit 1 ;;
	*) usage ;;
esac

DEFAULT_COUNTRY="$(node -p "require('$COUNTRIES/default.json').country")"
if [ -z "$COUNTRY" ]; then
	if [ "$DEFAULT_COUNTRY" = "_default" ]; then
		echo "Missing country." >&2
		usage
	fi
	COUNTRY="$DEFAULT_COUNTRY"
fi

if [ ! -f "$COUNTRIES/$COUNTRY/config.json" ]; then
	echo "Unknown country: $COUNTRY" >&2
	usage
fi

if [ "$MODE" = "release" ] && [ "$COUNTRY" = "_default" ]; then
	echo "_default is the test/development config and has no store listing: build it with 'debug'." >&2
	exit 1
fi

VERSION="$(node -p "require('$ROOT/app/package.json').version")"
if [ "$AAB" = 1 ]; then
	TASK_PREFIX="bundle"; EXT="aab"; SUBDIR="bundle"
else
	TASK_PREFIX="assemble"; EXT="apk"; SUBDIR="apk"
fi
MODE_CAP="$(echo "${MODE:0:1}" | tr '[:lower:]' '[:upper:]')${MODE:1}"
TASK="${TASK_PREFIX}${MODE_CAP}"

echo "Building $COUNTRY $VERSION ($MODE, $EXT)"
cd "$ROOT/app/android"
# TNT_COUNTRY is read by Metro (the JS bundle), -PtntCountry by Gradle (app id, name, icons).
TNT_COUNTRY="$COUNTRY" ./gradlew clean "$TASK" -PtntCountry="$COUNTRY"

OUT_DIR="app/build/outputs/$SUBDIR/$MODE"
SRC="$(ls "$ROOT/app/android/$OUT_DIR"/*."$EXT" 2>/dev/null | head -1 || true)"
if [ -z "$SRC" ]; then
	echo "Build finished but no .$EXT was found in app/android/$OUT_DIR" >&2
	exit 1
fi

mkdir -p "$ROOT/dist/mobile"
DEST="$ROOT/dist/mobile/$COUNTRY-$VERSION-$MODE.$EXT"
cp "$SRC" "$DEST"
echo "Built: $DEST"
[ "$OPEN" = 1 ] && open "$(dirname "$DEST")" || true
